# Core Application Settings
APP_ENV="development" # Set the application environment (e.g., "development", "production", "testing")
LOG_LEVEL="INFO"      # Controls the verbosity of logging (e.g., "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL")

# OpenAI / Large Language Model (LLM) Configuration
OPENAI_API_KEY="your_openai_api_key_here" # Required API key for accessing the OpenAI API
OPENAI_MODEL_NAME="gpt-3.5-turbo"         # The specific OpenAI model to use (e.g., gpt-4, gpt-3.5-turbo)
OPENAI_TEMPERATURE="0.7"                  # Controls the creativity/randomness of the model's output (0.0-1.0)
# OPENAI_BASE_URL="https://api.openai.com/v1" # Optional: Custom base URL for the OpenAI API (e.g., for proxies or compatible APIs)

# Agent Specific Settings
AGENT_MAX_ITERATIONS="10"                 # Maximum number of steps the AI agent can take in a single run
AGENT_DEBUG_MODE="false"                  # Set to "true" to enable detailed agent debugging output

# Memory Management
MEMORY_TYPE="in-memory"                   # Type of memory storage to use (e.g., "in-memory", "redis", "database")
# REDIS_URL="redis://localhost:6379/0"      # Optional: URL for connecting to a Redis instance, if MEMORY_TYPE is "redis"
# DATABASE_URL="sqlite:///./ai_agent.db"   # Optional: Connection string for a database, if MEMORY_TYPE is "database"

# LangChain Tracing and Observability (LangSmith/LangServe)
LANGCHAIN_TRACING_V2="false"              # Set to "true" to enable LangChain's tracing feature (LangSmith)
LANGCHAIN_API_KEY="your_langchain_api_key_here" # API key for LangSmith, if tracing is enabled
LANGCHAIN_PROJECT="default-ai-agent"      # Name of the LangSmith project to send traces to

# External Tool Configuration Examples
# If the agent uses external tools with their own API keys or endpoints, list them here.
# For example, if it uses a search engine API:
# SEARCH_API_KEY="your_search_api_key_here"
# SEARCH_API_URL="https://api.search.com/v1"