# Application Settings
APP_ENV="development" # Set the application environment (e.g., "production", "development")
LOG_LEVEL="INFO" # Set the desired logging level (e.g., "DEBUG", "INFO", "WARNING", "ERROR")

# LLM Provider Configuration
LLM_PROVIDER="openai" # The primary LLM provider to use (e.g., "openai", "anthropic"). Currently only OpenAI is supported.
OPENAI_API_KEY="your_openai_api_key_here" # Your OpenAI API key for accessing GPT models
# OPENAI_ORGANIZATION="your_openai_organization_id_here" # (Optional) Your OpenAI organization ID
AGENT_MODEL_NAME="gpt-4-turbo-preview" # The specific OpenAI model to use for the agent (e.g., "gpt-3.5-turbo", "gpt-4")

# Tool Integrations
SERPAPI_API_KEY="your_serpapi_api_key_here" # API key for SerpAPI, used for web search functionality

# LangChain Observability & Tracing (LangSmith)
LANGCHAIN_TRACING_V2="true" # Enable LangSmith tracing for debugging and monitoring agent runs
LANGCHAIN_API_KEY="your_langsmith_api_key_here" # Your API key for LangSmith
LANGCHAIN_PROJECT="ai-agent-project" # The name of your LangSmith project
# LANGCHAIN_ENDPOINT="https://api.langsmith.com" # (Optional) Override the LangSmith API endpoint if self-hosting

# Frontend Configuration (for React/Vite app)
VITE_APP_API_BASE_URL="http://localhost:8000/api" # The base URL for the backend API that the frontend will communicate with