# Application Settings
APP_NAME="AI Agent Framework" # The name of this application
ENVIRONMENT="development" # Application environment (e.g., development, staging, production)
APP_HOST="0.0.0.0" # Host for the FastAPI application
APP_PORT="8000" # Port for the FastAPI application
LOG_LEVEL="INFO" # Logging level (e.g., DEBUG, INFO, WARNING, ERROR)

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/ai_agent_db" # Connection URL for the PostgreSQL database

# Cache and Session Management (Redis)
REDIS_URL="redis://localhost:6379/0" # Connection URL for the Redis instance

# Vector Store Configuration (for long-term memory)
# Choose one of the following providers, and set relevant keys/configs.
# Common options: 'chroma', 'pinecone', 'weaviate', 'qdrant', 'milvus', 'azure_ai_search'
VECTOR_STORE_PROVIDER="chroma" # The vector store provider to use

# If using a cloud vector store (e.g., Pinecone, Weaviate, Qdrant):
# VECTOR_STORE_API_KEY="your_vector_store_api_key_here" # API key for the chosen vector store provider
# VECTOR_STORE_ENVIRONMENT="your_vector_store_environment_here" # Environment/region for the vector store
# VECTOR_STORE_INDEX_NAME="ai-agent-memory" # Default index name for vector storage

# If using local ChromaDB (e.g., 'chroma' provider):
CHROMA_DB_PATH="./data/chroma_db" # Local path for ChromaDB persistent storage

# Large Language Model (LLM) Configuration
LLM_PROVIDER="openai" # The default LLM provider to use (e.g., openai, anthropic, huggingface)
LLM_MODEL_NAME="gpt-4o" # The default LLM model name (e.g., gpt-4o, claude-3-opus-20240229, mixtral-8x7b-instruct-v0.1)
LLM_TEMPERATURE="0.7" # The sampling temperature for LLM responses (0.0 to 1.0)

# OpenAI Specific Configuration
OPENAI_API_KEY="your_openai_api_key_here" # API key for OpenAI services
# OPENAI_ORGANIZATION="your_openai_organization_id_here" # Optional: Your OpenAI organization ID

# Anthropic Specific Configuration
# ANTHROPIC_API_KEY="your_anthropic_api_key_here" # API key for Anthropic services

# Embedding Model Configuration
EMBEDDING_MODEL_NAME="text-embedding-ada-002" # Model name for generating embeddings
# EMBEDDING_API_KEY="your_embedding_provider_api_key_here" # Optional: API key if embedding provider differs from LLM

# External Tool Integrations (Examples)
# These variables would be required by specific tools implemented in src/tools/
# SERPAPI_API_KEY="your_serpapi_api_key_here" # API key for SerpAPI (e.g., for Google Search tool)
# GOOGLE_API_KEY="your_google_api_key_here" # API key for Google services
# GOOGLE_CSE_ID="your_google_custom_search_engine_id_here" # Custom Search Engine ID for Google Search

# Frontend Application Settings
FRONTEND_API_BASE_URL="http://localhost:8000/api" # Base URL for the backend API consumed by the frontend
FRONTEND_APP_TITLE="AI Agent Dashboard" # Title for the frontend application

# Observability / Tracing (OpenTelemetry example)
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317" # OTLP gRPC endpoint for OpenTelemetry collector
# OTEL_SERVICE_NAME="ai-agent-service" # Service name for OpenTelemetry tracing