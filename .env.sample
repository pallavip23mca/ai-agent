# Application Settings
APP_PORT=8000 # Port for the FastAPI application to listen on
APP_ENVIRONMENT=development # Application environment (e.g., development, staging, production)
LOG_LEVEL=INFO # Logging level (e.g., DEBUG, INFO, WARNING, ERROR, CRITICAL)

# LLM Configuration (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here # API key for OpenAI services
OPENAI_MODEL_NAME=gpt-4-turbo-preview # The default OpenAI model to use for the agent
# OPENAI_API_BASE=your_custom_openai_api_base_url # Optional: Custom API base URL for OpenAI (e.g., for proxies or local LLMs)

# Memory & Vector Store Configuration
REDIS_HOST=localhost # Hostname for the Redis server
REDIS_PORT=6379 # Port for the Redis server
# REDIS_PASSWORD=your_redis_password_here # Optional: Password for Redis authentication
# REDIS_DB=0 # Optional: Redis database number

CHROMA_PERSIST_DIRECTORY=./data/chromadb # Directory where ChromaDB should persist its data for RAG

# LangChain Observability (LangSmith)
LANGCHAIN_TRACING_V2=true # Enable LangChain V2 tracing for observability
LANGCHAIN_API_KEY=your_langsmith_api_key_here # API key for LangSmith
LANGCHAIN_PROJECT=ai-agent-project # Project name to group traces in LangSmith
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com # Optional: Custom LangSmith endpoint

# External Tools & Services
# Add specific environment variables for any external tools (e.g., search engines, calendars, custom APIs)
# that the agent will use.
SERPER_API_KEY=your_serper_api_key_here # API key for the Serper.dev search engine tool
# GOOGLE_CSE_ID=your_google_custom_search_engine_id # ID for Google Custom Search Engine
# GOOGLE_API_KEY=your_google_api_key_here # API key for Google services (e.g., Calendar, Custom Search)
# CALENDAR_API_URL=your_calendar_api_url_here # Base URL for a custom calendar API tool
# CUSTOM_TOOL_API_KEY=your_custom_tool_api_key_here # Example: API key for a generic custom tool

# Frontend Configuration (for Vite)
# Variables prefixed with VITE_ are exposed to the frontend build process
VITE_API_BASE_URL=/api # The base URL for the backend API from the frontend perspective